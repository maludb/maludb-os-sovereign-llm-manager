# Sovereign LLM Manager — config/.env (written by the kernel's installer at apply, the three ports pinned first by
# deploy/ROOT_STEPS.sh; design §14). Never commit the real file. Group www-data reads it; nothing in it is ever logged, printed or
# returned.
APP_ENV=prod
APP_DEBUG=0
APP_NAME="Sovereign LLM Manager"
APP_KEY=sovereign_llm_manager
APP_URL=https://llm.example.com
# the record database (the installer creates it and the three roles)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_sovereign_llm_manager
DB_USER=sovereign_llm_manager_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=sovereign_llm_manager_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=sovereign_llm_manager_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
# the ports (pinned before the first apply: deploy/ROOT_STEPS.sh step 0 -- the installer assigns APP_INTERNAL_PORT and the MCP
# endpoints' ports; design §14)
APP_INTERNAL_PORT=8202
MCP_RECORDS_PORT=8860
MCP_ACTIVITY_PORT=8861
# the kernel's (copied by the installer)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
# the tenant's one memory (activity episodes) — Sovereign LLM Manager keeps no memory database of its own
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
# mail (optional; the installer fills them from ~/.malumail or the kernel's) — notices only; Sovereign LLM Manager reads no mailbox
MALUMAIL_API_URL=https://api.malumail.com
MALUMAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# CORS origins for the token API, comma-separated (none by default)
API_CORS_ORIGINS=
